{
  "name": "contextos",
  "version": "0.1.0",
  "description": "AI Project Brain - CLI tool for context engineering",
  "keywords": [
    "cli",
    "ai",
    "llm",
    "context-engineering"
  ],
  "repository": {
    "type": "git",
    "url": "ContextOS"
  },
  "license": "MIT",
  "author": "Mustitrtk",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "contextos": "dist/index.js"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node ./dist/index.js",
    "prebuild": "rimraf dist",
    "build": "tsc",
    "dev": "ts-node ./index.ts",
    "lint": "eslint index.ts",
    "format": "prettier --write \"index.ts\""
  },
  "dependencies": {
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "dotenv": "^17.3.1",
    "fs-extra": "^11.1.1",
    "inquirer": "^9.2.11"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.8.0",
    "prettier": "^3.0.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2"
  }
}
